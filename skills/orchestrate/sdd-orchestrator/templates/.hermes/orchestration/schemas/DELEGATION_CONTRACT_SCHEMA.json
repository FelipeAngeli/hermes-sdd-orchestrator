{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DELEGATION_CONTRACT_SCHEMA.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "parent_agent_id",
    "child_agent_id",
    "session_id",
    "workspace_id",
    "stage",
    "objective",
    "input_artifacts",
    "acceptance_criteria",
    "allowed_tools",
    "dependencies",
    "timeout",
    "retry_policy",
    "token_budget",
    "output_schema"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parent_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "child_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts"
      ],
      "properties": {
        "max_attempts": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "token_budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "output_schema": {
      "$ref": "#/$defs/artifact"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
