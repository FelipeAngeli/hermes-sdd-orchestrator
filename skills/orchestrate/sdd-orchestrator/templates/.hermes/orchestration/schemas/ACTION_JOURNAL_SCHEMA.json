{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action Journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["journal_version", "workspace", "action", "fingerprints", "process", "artifact", "state_commit", "incidents"],
  "properties": {
    "journal_version": {"const": 1},
    "workspace": {"$ref": "#/$defs/workspace"},
    "action": {"$ref": "#/$defs/action"},
    "fingerprints": {"$ref": "#/$defs/fingerprints"},
    "process": {"$ref": "#/$defs/process"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "state_commit": {"$ref": "#/$defs/state_commit"},
    "incidents": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "workspace": {"type": "object", "additionalProperties": false, "required": ["path", "branch", "head", "git_common_dir"], "properties": {"path": {"type": "string"}, "branch": {"type": "string"}, "head": {"type": "string"}, "git_common_dir": {"type": "string"}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "ticket", "stage", "name", "status", "executor", "schema_path", "protocol_version", "prompt_hash", "final_message_path", "attempt", "retry_mode", "parent_action_id", "parent_artifact_path", "parent_artifact_sha256", "invalid_fields", "allowed_corrections"], "properties": {"id": {"type": ["string", "null"]}, "ticket": {"type": ["string", "null"]}, "stage": {"type": ["string", "null"]}, "name": {"type": ["string", "null"]}, "status": {"enum": ["IDLE", "PREPARED", "DISPATCHED", "PROCESS_FINISHED", "ARTIFACT_READY", "VALIDATED", "STATE_COMMITTED", "RELEASED", "BLOCKED", "INTERRUPTED"]}, "executor": {"type": ["string", "null"]}, "schema_path": {"type": ["string", "null"]}, "protocol_version": {"type": ["integer", "null"]}, "prompt_hash": {"type": ["string", "null"]}, "final_message_path": {"type": ["string", "null"]}, "attempt": {"type": "integer", "minimum": 0}, "retry_mode": {"type": ["string", "null"], "enum": ["FULL_REPLACEMENT", "METADATA_OVERLAY", null]}, "parent_action_id": {"type": ["string", "null"]}, "parent_artifact_path": {"type": ["string", "null"]}, "parent_artifact_sha256": {"type": ["string", "null"]}, "invalid_fields": {"type": "array", "items": {"type": "string"}}, "allowed_corrections": {"type": "array", "items": {"type": "string"}}}},
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["baseline", "ownership", "state_before"], "properties": {"baseline": {"type": ["string", "null"]}, "ownership": {"type": ["string", "null"]}, "state_before": {"type": ["string", "null"]}}},
    "process": {"type": "object", "additionalProperties": false, "required": ["started_at", "finished_at", "exit_code"], "properties": {"started_at": {"type": ["string", "null"]}, "finished_at": {"type": ["string", "null"]}, "exit_code": {"type": ["integer", "null"]}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["exists", "sha256", "validation_status"], "properties": {"exists": {"type": "boolean"}, "sha256": {"type": ["string", "null"]}, "validation_status": {"enum": ["PENDING", "VALID", "INVALID"]}}},
    "state_commit": {"type": "object", "additionalProperties": false, "required": ["state_path", "expected_before_hash", "expected_after_hash", "committed_after_hash", "committed_at", "verified"], "properties": {"state_path": {"type": ["string", "null"]}, "expected_before_hash": {"type": ["string", "null"]}, "expected_after_hash": {"type": ["string", "null"]}, "committed_after_hash": {"type": ["string", "null"]}, "committed_at": {"type": ["string", "null"]}, "verified": {"type": "boolean"}}}
  }
}
