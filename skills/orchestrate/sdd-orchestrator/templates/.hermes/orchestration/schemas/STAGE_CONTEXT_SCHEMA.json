{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage context and slice contract v2",
  "description": "Controller-owned, per-dispatch context manifest checked by runtime/stage_context.py before a worker runs. It lists scoped excerpts and byte-verified project-local playbooks, never whole repository documents or transcripts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_root",
    "ticket",
    "stage",
    "limits",
    "project_context",
    "sources",
    "playbooks",
    "divergences",
    "slice",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "$ref": "#/$defs/text"
    },
    "stage": {
      "enum": [
        "SPECIFY",
        "CLARIFY",
        "PLAN",
        "TASKS",
        "IMPLEMENT",
        "TEST",
        "REVIEW"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sources",
        "max_lines_per_source"
      ],
      "properties": {
        "max_sources": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines_per_source": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_head",
        "obsidian",
        "evidence",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "REFRESHED",
            "PARTIAL",
            "MISSING"
          ]
        },
        "checked_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "obsidian": {
          "enum": [
            "BOUND",
            "UNBOUND",
            "NOT_CONFIGURED"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "lines",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "RULES",
              "ARCHITECTURE",
              "SPEC",
              "DECISION",
              "EVIDENCE",
              "CODE",
              "CONTRACT"
            ]
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "lines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "path", "sha256", "references", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {
                  "$ref": "#/$defs/text"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code_path",
          "doc_path",
          "summary",
          "authority"
        ],
        "properties": {
          "code_path": {
            "$ref": "#/$defs/text"
          },
          "doc_path": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "authority": {
            "const": "CODE"
          }
        }
      }
    },
    "slice": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_slice_ids",
            "completed_slice_ids",
            "editable_paths",
            "required_playbooks",
            "acceptance",
            "required_verification"
          ],
          "properties": {
            "current_slice_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "completed_slice_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "editable_paths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "required_playbooks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "slice_ids"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "slice_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              }
            },
            "acceptance": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "criterion",
                  "verification_method",
                  "verifier",
                  "slice_id"
                ],
                "properties": {
                  "criterion": {
                    "$ref": "#/$defs/text"
                  },
                  "verification_method": {
                    "$ref": "#/$defs/text"
                  },
                  "verifier": {
                    "enum": [
                      "AGENT",
                      "HUMAN"
                    ]
                  },
                  "slice_id": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "required_verification": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "command",
                  "check_ids",
                  "introduced_by_slice"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/text"
                  },
                  "kind": {
                    "enum": [
                      "TEST",
                      "STATIC_ANALYSIS",
                      "SCHEMA_VALIDATION",
                      "STATE_INSPECTION",
                      "LOG_INSPECTION",
                      "HUMAN"
                    ]
                  },
                  "command": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/text"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "check_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "introduced_by_slice": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_slice_sha256s",
            "evidence"
          ],
          "properties": {
            "approved_slice_sha256s": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "evidence": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  }
}
