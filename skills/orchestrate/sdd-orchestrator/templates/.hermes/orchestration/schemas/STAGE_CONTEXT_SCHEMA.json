{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage context and slice contract v2",
  "description": "Controller-owned, per-dispatch context manifest checked by runtime/stage_context.py before a worker runs. It lists scoped excerpts and byte-verified project-local playbooks, never whole repository documents or transcripts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_root",
    "ticket",
    "stage",
    "limits",
    "project_context",
    "sources",
    "playbooks",
    "divergences",
    "slice",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "$ref": "#/$defs/text"
    },
    "stage": {
      "enum": [
        "SPECIFY",
        "CLARIFY",
        "PLAN",
        "TASKS",
        "IMPLEMENT",
        "TEST",
        "REVIEW"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sources",
        "max_lines_per_source"
      ],
      "properties": {
        "max_sources": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines_per_source": {
          "type": "integer",
          "minimum": 1
        },
        "max_prompt_bytes": {
          "description": "Upper bound for the worker prompt built from this manifest; stage_context.py check --prompt-file enforces it (default 49152 when absent).",
          "type": "integer",
          "minimum": 1024
        }
      }
    },
    "dispatch": {
      "description": "DISPATCH_POLICY dispatch question for a sub-agent (role) dispatch: the pending decision its answer resolves, the deterministic tool tried first, and what changes on NO_FINDINGS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pending_decision", "deterministic_attempt", "if_empty"],
      "properties": {
        "pending_decision": {"type": "string", "minLength": 1},
        "deterministic_attempt": {"type": "string", "minLength": 1},
        "if_empty": {"type": "string", "minLength": 1}
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_head",
        "obsidian",
        "evidence",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "REFRESHED",
            "PARTIAL",
            "MISSING"
          ]
        },
        "checked_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "obsidian": {
          "enum": [
            "BOUND",
            "UNBOUND",
            "NOT_CONFIGURED"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "lines",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "RULES",
              "ARCHITECTURE",
              "SPEC",
              "DECISION",
              "EVIDENCE",
              "CODE",
              "CONTRACT"
            ]
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "lines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "path", "sha256", "references", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {
                  "$ref": "#/$defs/text"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code_path",
          "doc_path",
          "summary",
          "authority"
        ],
        "properties": {
          "code_path": {
            "$ref": "#/$defs/text"
          },
          "doc_path": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "authority": {
            "const": "CODE"
          }
        }
      }
    },
    "context_graph": {
      "description": "Optional. The result of runtime/context_graph.py query for this dispatch: which graph nodes, rules, tests and prior decisions are connected to the work. Absent means the project keeps no context graph.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "selectors",
            "nodes",
            "decisions",
            "unresolved",
            "findings"
          ],
          "properties": {
            "status": {
              "enum": [
                "CURRENT",
                "REFRESHED",
                "PARTIAL",
                "MISSING",
                "NOT_CONFIGURED"
              ]
            },
            "source": {
              "enum": [
                "OBSIDIAN",
                "REPOSITORY"
              ]
            },
            "selectors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "note",
                  "distance"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "kind": {
                    "enum": [
                      "MODULE",
                      "RULE",
                      "TEST",
                      "DECISION",
                      "DOC"
                    ]
                  },
                  "note": {
                    "$ref": "#/$defs/text"
                  },
                  "distance": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "reason",
                  "date"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "reason": {
                    "$ref": "#/$defs/text"
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            },
            "unresolved": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "semantic_governance": {
      "description": "Required for PLAN and IMPLEMENT when PROJECT_SETUP.md records automatic Jev consent: the cached semantic_governor.py fingerprint, typed request and canonical current routing-STATE SHA-256. REVIEW needs human resolution unless a current verified SHADOW request preserves the deterministic baseline.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint",
            "review_resolution"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "review_resolution": {
              "anyOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "SHADOW",
                "ACTIVE",
                "FALLBACK"
              ]
            },
            "request": {
              "type": "object"
            },
            "current_state_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "slice": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_slice_ids",
            "completed_slice_ids",
            "editable_paths",
            "required_playbooks",
            "acceptance",
            "required_verification"
          ],
          "properties": {
            "current_slice_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "completed_slice_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "editable_paths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "required_playbooks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "slice_ids"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "slice_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              }
            },
            "acceptance": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "criterion",
                  "verification_method",
                  "verifier",
                  "slice_id"
                ],
                "properties": {
                  "criterion": {
                    "$ref": "#/$defs/text"
                  },
                  "verification_method": {
                    "$ref": "#/$defs/text"
                  },
                  "verifier": {
                    "enum": [
                      "AGENT",
                      "HUMAN"
                    ]
                  },
                  "slice_id": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "required_verification": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "command",
                  "check_ids",
                  "introduced_by_slice"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/text"
                  },
                  "kind": {
                    "enum": [
                      "TEST",
                      "STATIC_ANALYSIS",
                      "SCHEMA_VALIDATION",
                      "STATE_INSPECTION",
                      "LOG_INSPECTION",
                      "HUMAN"
                    ]
                  },
                  "command": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/text"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "check_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "introduced_by_slice": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_slice_sha256s",
            "evidence"
          ],
          "properties": {
            "approved_slice_sha256s": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "evidence": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  }
}
