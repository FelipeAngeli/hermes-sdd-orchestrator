{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["review_result"],
  "additionalProperties": false,
  "properties": {
    "review_result": {
      "type": "object",
      "required": ["schema_version", "status", "reviewed_paths", "findings", "baseline", "ownership", "acceptance", "e2e", "forbidden_actions", "gate_status", "next_step"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "const": 3},
        "status": {"type": "string", "enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"]},
        "reviewed_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "path", "description", "evidence"],
            "additionalProperties": false,
            "properties": {
              "severity": {"$ref": "#/$defs/text"},
              "path": {"$ref": "#/$defs/text"},
              "description": {"$ref": "#/$defs/text"},
              "evidence": {"$ref": "#/$defs/text"}
            }
          }
        },
        "baseline": {
          "type": "object",
          "required": ["preserved", "violations"],
          "additionalProperties": false,
          "properties": {
            "preserved": {"type": "boolean"},
            "violations": {"type": "array", "items": {"$ref": "#/$defs/path"}}
          }
        },
        "ownership": {
          "type": "object",
          "required": ["valid", "violations"],
          "additionalProperties": false,
          "properties": {
            "valid": {"type": "boolean"},
            "violations": {"type": "array", "items": {"$ref": "#/$defs/path"}}
          }
        },
        "acceptance": {
          "type": "object",
          "required": ["verified", "expected_check_ids", "checks"],
          "additionalProperties": false,
          "properties": {
            "verified": {"type": "boolean"},
            "expected_check_ids": {
              "type": "array",
              "items": {"$ref": "#/$defs/text"}
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "criterion", "verification_method", "verifier", "slice_id", "status", "evidence", "waiver"],
                "additionalProperties": false,
                "properties": {
                  "id": {"$ref": "#/$defs/text"},
                  "criterion": {"$ref": "#/$defs/text"},
                  "verification_method": {"$ref": "#/$defs/text"},
                  "verifier": {"type": "string", "enum": ["AGENT", "HUMAN"]},
                  "slice_id": {"$ref": "#/$defs/text"},
                  "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "WAIVED"]},
                  "evidence": {"$ref": "#/$defs/text"},
                  "waiver": {"anyOf": [{"$ref": "#/$defs/waiver"}, {"type": "null"}]}
                }
              }
            }
          }
        },
        "e2e": {
          "type": "object",
          "required": ["files_modified", "execution_performed", "violation"],
          "additionalProperties": false,
          "properties": {
            "files_modified": {"type": "boolean"},
            "execution_performed": {"type": "boolean"},
            "violation": {"type": "boolean"}
          }
        },
        "forbidden_actions": {
          "type": "object",
          "required": ["violations"],
          "additionalProperties": false,
          "properties": {
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action"],
                "additionalProperties": false,
                "properties": {"action": {"$ref": "#/$defs/text"}}
              }
            }
          }
        },
        "gate_status": {
          "type": "object",
          "required": ["focused_tests", "format", "analyze", "ci"],
          "additionalProperties": false,
          "properties": {
            "focused_tests": {"type": "string", "enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED", "PENDING"]},
            "format": {"type": "string", "enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED", "PENDING"]},
            "analyze": {"type": "string", "enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED", "PENDING"]},
            "ci": {"type": "string", "enum": ["PASS", "FAIL", "TIMEOUT", "BLOCKED", "PENDING", "NOT_APPLICABLE", "DISABLED_BY_PROJECT_POLICY"]}
          }
        },
        "next_step": {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {"action": {"$ref": "#/$defs/text"}}
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "path": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/text"}}
    },
    "waiver": {
      "type": "object",
      "required": ["by", "reason", "quote", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "by": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "quote": {"$ref": "#/$defs/text"},
        "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    }
  }
}
