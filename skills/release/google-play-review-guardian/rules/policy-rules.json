  {
   "id": "POL-PLAY-BILLING",
   "name": "Google Play Billing para bens/serviços digitais",
   "description": "Compras de funcionalidades, conteúdo digital, assinaturas e serviços em nuvem devem usar o Google Play Billing, salvo exceções (bens físicos, serviços presenciais, P2P, doações isentas, programas de faturamento alternativo).",
   "category": "billing",
   "official_url": "https://support.google.com/googleplay/android-developer/answer/9858738?hl=en",
   "consulted_at": "2026-10-16",
   "effective_from": "2020-09-28",
   "platforms_affected": [
    "phone/tablet",
    "wear",
    "tv",
    "automotive",
    "xr"
   ],
   "applies_when": "App vende funcionalidades ou conteúdo digital.",
   "severity_if_violated": "WARNING",
   "verification_method": "heuristic",
   "requirement_level": "mandatory",
   "exemptions": [
    "physical goods",
    "physical services",
    "credit card / utility bill remittance",
    "peer-to-peer payments",
    "online auctions",
    "tax exempt donations",
    "real-money gambling (per policy)",
    "alternative billing / external offers programs in eligible regions (enrollment required)"
   ]
  },
  {
   "id": "POL-CLOSED-TESTING",
   "name": "Teste fechado para novas contas pessoais",
   "description": "Contas pessoais criadas após 2023-11-13 precisam de teste fechado com ≥ 12 testadores inscritos continuamente por ≥ 14 dias antes de solicitar acesso à produção.",
   "category": "testing",
   "official_url": "https://support.google.com/googleplay/android-developer/answer/14151465?hl=en",
   "consulted_at": "2026-10-16",
   "effective_from": "2023-11-13",
   "platforms_affected": [
    "phone/tablet",
    "wear",
    "tv",
    "automotive",
    "xr"
   ],
   "applies_when": "Conta de desenvolvedor PESSOAL criada após 2023-11-13 que ainda não obteve acesso à produção. Não se aplica a contas organizacionais.",
   "severity_if_violated": "WARNING",
   "verification_method": "manual",
   "requirement_level": "mandatory",
   "conditions": {
    "account_type": "personal",
    "account_created_after": "2023-11-13",
    "min_testers": 12,
    "min_consecutive_days": 14,
    "requires_production_access_application": true
   },
   "source_quote": "Developers with personal accounts created after November 13, 2023, must run a closed test for their app with a minimum of 12 testers who have been opted in continuously for at least 14 days."
  },
