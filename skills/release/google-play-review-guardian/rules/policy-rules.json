  {
   "id": "POL-PHOTO-VIDEO",
   "name": "Permissões de fotos e vídeos",
   "description": "Apps com target ≥ 33 só podem pedir READ_MEDIA_IMAGES/READ_MEDIA_VIDEO se pickers do sistema não bastarem; exige declaração no Play Console.",
   "category": "permissions",
   "official_url": "https://support.google.com/googleplay/android-developer/answer/13161072?hl=en",
   "consulted_at": "2026-10-16",
   "effective_from": "2024-08-31",
   "platforms_affected": [
    "phone/tablet",
    "wear",
    "tv",
    "automotive",
    "xr"
   ],
   "applies_when": "Manifest declara READ_MEDIA_IMAGES ou READ_MEDIA_VIDEO.",
   "severity_if_violated": "WARNING",
   "verification_method": "deterministic",
   "requirement_level": "mandatory",
   "permissions": [
    "android.permission.READ_MEDIA_IMAGES",
    "android.permission.READ_MEDIA_VIDEO"
   ],
   "source_quote": "Apps that target Android 13 or higher (API level 33+) may only request the READ_MEDIA_IMAGES and READ_MEDIA_VIDEO permissions if system pickers (like the Android Photo Picker ) are not sufficient for your app to provide core functionality."
  },
  {
